      <outgoing>F5</outgoing>
    </task>
    <task id="C" name="Frontend" po:duration="8" po:cost="6000">
      <incoming>F4</incoming>
      <outgoing>F6</outgoing>
    </task>
    <parallelGateway id="G2">
      <incoming>F5</incoming>
      <incoming>F6</incoming>
      <outgoing>F7</outgoing>
    </parallelGateway>
    <task id="D" name="Test" po:duration="4" po:cost="2000" po:parallelizable="false">
      <incoming>F7</incoming>
      <outgoing>F8</outgoing>
    </task>
    <exclusiveGateway id="G3" name="Where to deploy?">
      <incoming>F8</incoming>
      <outgoing>F9</outgoing>
      <outgoing>F10</outgoing>
    </exclusiveGateway>
    <task id="E" name="Deploy on-prem" po:duration="2" po:cost="3000">
