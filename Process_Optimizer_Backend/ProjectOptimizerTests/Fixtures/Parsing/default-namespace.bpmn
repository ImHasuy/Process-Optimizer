      <outgoing>F11</outgoing>
    </task>
    <task id="F" name="Deploy to cloud" po:duration="1" po:cost="5000">
      <incoming>F10</incoming>
      <outgoing>F12</outgoing>
    </task>
    <exclusiveGateway id="G4">
      <incoming>F11</incoming>
      <incoming>F12</incoming>
      <outgoing>F13</outgoing>
    </exclusiveGateway>
    <endEvent id="End" name="Done">
      <incoming>F13</incoming>
    </endEvent>
    <sequenceFlow id="F1" sourceRef="S" targetRef="A" />
    <sequenceFlow id="F2" sourceRef="A" targetRef="G1" />
    <sequenceFlow id="F3" sourceRef="G1" targetRef="B" />
    <sequenceFlow id="F4" sourceRef="G1" targetRef="C" />
